# Copy this file to server/.env and fill in the real value. Never commit .env.

# MongoDB connection string: the Atlas cluster's (Connect > Drivers), or a local MongoDB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat

# Port the page and the socket connection share. Optional, defaults to 3000.
# PORT=3000
# The AI behind @bot: any OpenAI-compatible API. Get a Typhoon key at playground.opentyphoon.ai.
# Without these the app still runs, and bot answers that it is unavailable.
AI_BASE_URL=https://api.opentyphoon.ai/v1
AI_MODEL=typhoon-v2.5-30b-a3b-instruct
AI_API_KEY=